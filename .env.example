VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Cloudflare Turnstile site key (not the secret). If left empty, the client
# signs in anonymously without a captcha challenge — useful for local dev.
VITE_TURNSTILE_SITE_KEY=

# Shown on the "Approved" screen, e.g. "Collect from the TinkerSpace lab, Mon-Fri 4-6 pm." Leave empty until confirmed.
VITE_PICKUP_INFO=
